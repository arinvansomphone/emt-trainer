# Required: OpenAI API key for chat
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Server port (default 3001; Vite dev proxy expects 3001)
# PORT=3001

# Optional: daily OpenAI token cap across all users (default 1500000)
# DAILY_TOKEN_BUDGET=1500000

# Optional: max POST requests per minute per IP (default 300)
# RATE_LIMIT_PER_MIN=300

# Optional: URL for the "Send feedback" footer link (build-time; e.g. a Google Form)
# VITE_FEEDBACK_URL=
